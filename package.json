{
  "name": "quantumscope",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src *.json *.mjs next.config.ts README.md",
    "format:check": "prettier --check src *.json *.mjs next.config.ts README.md",
    "test:history": "node scripts/check-history.cjs",
    "test:polish": "node scripts/check-polish.cjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tooltip": "1.2.16",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
